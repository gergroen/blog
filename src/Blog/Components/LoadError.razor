<div class="notice">
    <p><strong>Could not load this content.</strong></p>
    <p>You might be offline, and this page hasn't been saved for offline reading yet. Check your connection and try again.</p>
    <button class="button" @onclick="Retry">Try again</button>
</div>

@code {
    [Parameter] public EventCallback OnRetry { get; set; }

    private Task Retry() => OnRetry.InvokeAsync();
}

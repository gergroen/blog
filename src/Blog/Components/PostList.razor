@if (Posts.Count == 0)
{
    <p class="muted">No posts yet.</p>
}
else
{
    <ol class="post-list">
        @foreach (var post in Posts)
        {
            <li class="post-card">
                <h2><a href="post/@post.Slug">@post.Title</a></h2>
                <PostInfo Post="post" />
                @if (post.Summary.Length > 0)
                {
                    <p>@post.Summary</p>
                }
            </li>
        }
    </ol>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PostMeta> Posts { get; set; } = [];
}
